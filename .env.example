POSTGRES_USER=apd
POSTGRES_PASSWORD=apd
POSTGRES_DB=apd_dashboard

# Required. Generate a random secret, e.g.: openssl rand -base64 32
JWT_SECRET=

# Optional. Ollama server for the AI Assistant feature (see README's "AI
# Assistant" section). Defaults assume Ollama runs on the same machine that
# hosts this app, outside Docker — host.docker.internal lets the backend
# container reach it. Override if Ollama runs elsewhere, and make sure the
# model below has been pulled on that server (ollama pull llama3.1).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
