DATABASE_URL="postgresql://apd:apd@localhost:5432/apd_dashboard"
PORT=4000
# Generate a random secret, e.g.: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me

# Optional. The SPA never actually needs cross-origin access to this API
# (see backend/src/index.ts's CORS setup) — leave unset and CORS stays
# fully locked down. Only set this if something other than this app's own
# frontend (through nginx/Vite's proxy) needs to call the API directly
# from a browser, e.g. https://pm.example.com.
FRONTEND_URL=

# Optional. Ollama server for the AI Assistant, meeting-minutes-from-
# transcript, and action-extraction features. Running the backend
# directly on the host (not via docker-compose) means Ollama is reachable
# at localhost; docker-compose.yml overrides this to host.docker.internal
# for the containerized deployment. OLLAMA_CHAT_MODEL and
# OLLAMA_VISION_MODEL must each match a tag Ollama actually has pulled
# EXACTLY — a bare "ollama pull llama3.1" can land as a versioned tag like
# "llama3.1:8b" rather than "llama3.1:latest", and Ollama's API 404s on
# any mismatch rather than falling back. Run `ollama list` on that server
# and copy the NAME column verbatim. OLLAMA_MODEL is a legacy alias for
# OLLAMA_CHAT_MODEL, kept for deployments that only set that.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava

# Optional. Connects to an Engineering Archive instance
# (a separate engineering asset/document archive service) — site visit photos get
# exported to it on upload, and its assets/photos/files can be linked to a
# project from the Site & Records tab. Leave all unset to disable the
# integration entirely (nothing breaks; the export/search UI just won't
# appear). Create the key on the Archive's own Integrations page (needs
# both 'read' and 'write' scope) — it's checked on every /api/external/*
# call via an X-API-Key header, so treat it like a password.
#
# BASE_URL is where THIS BACKEND reaches the Archive from inside its own
# container/host — with docker-compose that's usually
# http://host.docker.internal:<archive's WEB_PORT>, not the Archive's LAN
# address. PUBLIC_URL is what a browser can actually open, used only to
# build the "view in Archive" links stored on a project — falls back to
# BASE_URL if unset, which is fine outside Docker but almost certainly
# wrong (an unreachable link) when BASE_URL is a host.docker.internal one.
ENGINEERING_ARCHIVE_BASE_URL=
ENGINEERING_ARCHIVE_PUBLIC_URL=
ENGINEERING_ARCHIVE_API_KEY=

# Optional. Enables the daily email digest (overdue/due-soon tasks, RFIs,
# permits, and insurance/warranties — the same items the in-app notification
# bell flags). Leave SMTP_HOST unset to disable the feature entirely; even
# with it set, a user only receives digests once they opt in from the
# "Email Digest" item in their account menu (off by default for everyone).
# SMTP_PORT defaults to 587; set it to 465 for implicit TLS. SMTP_USER/PASS
# are optional (some internal relays accept unauthenticated mail on a
# trusted network).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Project Management Dashboard <no-reply@example.com>"

# Optional. Cron expression (server-local time) for when the digest sends —
# defaults to "0 7 * * *" (7am daily). An invalid expression disables
# scheduling (logged at startup) rather than crashing the API.
DIGEST_CRON="0 7 * * *"

# Optional. The externally-reachable base URL for this deployment (e.g.
# https://pm.example.com), used only to build clickable project links in
# digest emails — an email opened outside the browser has no way to infer
# this itself. Leave unset and digest emails still send, just without links.
PUBLIC_APP_URL=
